{
  "name": "folder-tag-management",
  "version": "1.0.0",
  "description": "フォルダとGitHubプロジェクトを管理するデスクトップアプリ",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare-icon && vite",
    "build": "npm run prepare-icon && tsc && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "prepare-icon": "node scripts/prepare-icon.mjs",
    "create-shortcut": "node scripts/create-shortcut.mjs",
    "create-shortcut:packaged": "node scripts/create-shortcut.mjs --packaged",
    "electron:pack": "npm run build && electron-builder --win dir",
    "setup-shortcut": "npm run create-shortcut -- --packaged",
    "electron:build": "npm run build && electron-builder && npm run create-shortcut -- --packaged --skip-pack"
  },
  "build": {
    "appId": "com.folder-tag-management.app",
    "productName": "Folder Tag Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folder Tag Manager"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  }
}
